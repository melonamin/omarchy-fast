#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

duration="${1:-5}"
plugin_dir=$(cd "$(dirname "$0")" && pwd)
phase_helper="${MELONAMIN_FAST_HELPER:-$plugin_dir/run-speedtest}"
state_dir="${MELONAMIN_FAST_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugins/melonamin.fast}"
child_pid=""

[[ $duration =~ ^[0-9]+$ ]] && (( duration > 0 )) || {
  echo "Duration must be a positive integer" >&2
  exit 2
}

mkdir -p "$state_dir"
exec 9>"$state_dir/speedtest.lock"
if ! flock -n 9; then
  echo "Another Fast speed test is already running" >&2
  exit 75
fi

# Both phase helpers inherit this descriptor and state path. The wrapper keeps
# descriptor 9 locked until upload finishes, leaving no inter-phase race for
# the passive timer to enter.
export MELONAMIN_FAST_LOCK_HELD=1
export MELONAMIN_FAST_STATE_DIR="$state_dir"

stop_child() {
  [[ -n $child_pid ]] || return 0
  kill -TERM "$child_pid" 2>/dev/null || true
  wait "$child_pid" 2>/dev/null || true
  child_pid=""
}

trap 'stop_child; exit 143' TERM INT HUP
trap stop_child EXIT

run_phase() {
  local direction=$1 status
  printf '__MELONAMIN_FAST_PHASE__:%s\n' "$direction"
  "$phase_helper" "$direction" "$duration" &
  child_pid=$!
  if wait "$child_pid"; then
    status=0
  else
    status=$?
  fi
  child_pid=""
  return "$status"
}

run_phase down
run_phase up

trap - TERM INT HUP
exit 0
