#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

duration="${1:-5}"
plugin_dir=$(cd "$(dirname "$0")" && pwd)
phase_helper="${MELONAMIN_FAST_HELPER:-$plugin_dir/run-speedtest}"
state_helper="$plugin_dir/safe-state"
child_pid=""

[[ $duration =~ ^[0-9]+$ ]] && (( duration > 0 )) || {
  echo "Duration must be a positive integer" >&2
  exit 2
}

if [[ ${MELONAMIN_FAST_LOCK_HELD:-0} != 1 ]]; then
  exec "$state_helper" lock -- "$0" "$duration"
fi

# The state helper's no-follow descriptor remains locked across both child
# phases, leaving no inter-phase race for the passive timer to enter.

stop_child() {
  [[ -n $child_pid ]] || return 0
  kill -TERM "$child_pid" 2>/dev/null || true
  wait "$child_pid" 2>/dev/null || true
  child_pid=""
}

trap 'stop_child; exit 143' TERM INT HUP
trap stop_child EXIT

run_phase() {
  local direction=$1 status
  printf '__MELONAMIN_FAST_PHASE__:%s\n' "$direction"
  "$phase_helper" "$direction" "$duration" &
  child_pid=$!
  if wait "$child_pid"; then
    status=0
  else
    status=$?
  fi
  child_pid=""
  return "$status"
}

run_phase down
run_phase up

trap - TERM INT HUP
exit 0
