#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

plugin_dir=$(cd "$(dirname "$0")" && pwd)
helper="${MELONAMIN_FAST_HELPER:-$plugin_dir/run-speedtest}"
status_command="${MELONAMIN_FAST_STATUS_COMMAND:-omarchy-network-status}"
state_helper="$plugin_dir/safe-state"
duration="${MELONAMIN_FAST_DURATION:-3}"

[[ $duration =~ ^[0-9]+$ ]] && (( duration > 0 )) || {
  echo "MELONAMIN_FAST_DURATION must be a positive integer" >&2
  exit 2
}

if [[ ${MELONAMIN_FAST_LOCK_HELD:-0} != 1 ]]; then
  exec "$state_helper" lock --busy-ok -- "$0"
fi

download_samples=$("$helper" down "$duration")
upload_samples=$("$helper" up "$duration")

settled_average() {
  local samples=$1
  local sample_total skip
  sample_total=$(awk 'NF { count++ } END { print count + 0 }' <<<"$samples")
  skip=0
  if (( sample_total >= 20 )); then
    skip=$((sample_total / 5))
    (( skip > 10 )) && skip=10
  elif (( sample_total >= 3 )); then
    skip=1
  fi

  awk -v skip="$skip" 'NR > skip { total += $1; count++ }
    END { if (count > 0) printf "%.6f", total / count; else print "0" }' <<<"$samples"
}

download=$(settled_average "$download_samples")
upload=$(settled_average "$upload_samples")
details=$("$status_command" --verbose 2>/dev/null || true)
ping=$(awk -F '\t' '$1 == "internet_ping_ms" { print $2; exit }' <<<"$details")
timestamp=$(date +%s%3N)

history_arguments=(
  history-add
  --timestamp "$timestamp"
  --down "$download"
  --up "$upload"
  --automatic
)
if [[ $ping =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  history_arguments+=(--ping "$ping")
  ping_valid=true
else
  ping_valid=false
fi

"$state_helper" "${history_arguments[@]}" >/dev/null

printf 'Fast monitor complete: down %.1f Mbps, up %.1f Mbps' "$download" "$upload"
if [[ $ping_valid == true ]]; then printf ', ping %.1f ms' "$ping"; fi
printf '\n'
